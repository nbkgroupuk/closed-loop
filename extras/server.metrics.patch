+from starlette.middleware.base import BaseHTTPMiddleware
+
+# Import monitoring module defensively. If import fails, monitoring will be None and middleware will
+# behave as a no-op (metrics won't be emitted but app remains functional).
+try:
+    from app import monitoring
+except Exception:
+    monitoring = None
+
+
+class PrometheusMiddleware(BaseHTTPMiddleware):
+    async def dispatch(self, request, call_next):
+        """
+        Measure request duration and record metrics via app.monitoring.observe_request().
+        This middleware is defensive and must never let metric errors bubble up.
+        """
+        endpoint = request.url.path
+        method = request.method
+        start = time.time()
+        try:
+            resp = await call_next(request)
+            status = getattr(resp, "status_code", 200)
+            duration = time.time() - start
+            # best-effort metric observation; observe_request will swallow exceptions
+            try:
+                if monitoring and hasattr(monitoring, "observe_request"):
+                    monitoring.observe_request(method=method, endpoint=endpoint, status=status, duration=duration, failed=(status >= 400))
+            except Exception:
+                # absolutely do not raise from middleware due to metrics issues
+                logging.getLogger("gateway.metrics").debug("metric observe failed", exc_info=True)
+            return resp
+        except Exception:
+            # record failure (best-effort) and re-raise so upper middleware/exception handlers run
+            try:
+                if monitoring and hasattr(monitoring, "observe_request"):
+                    monitoring.observe_request(method=method, endpoint=endpoint, status=500, duration=(time.time() - start), failed=True)
+            except Exception:
+                logging.getLogger("gateway.metrics").debug("metric observe on exception failed", exc_info=True)
+            raise
+
+
+# Attach middleware (wrap in try to be extra-safe)
+try:
+    app.add_middleware(PrometheusMiddleware)
+except Exception:
+    logging.getLogger("gateway.server").exception("Failed to attach PrometheusMiddleware (continuing without it)")
+
+
+# Register monitoring endpoints (if available). Using include_router keeps server.py minimal.
+if monitoring and hasattr(monitoring, "router"):
+    try:
+        app.include_router(monitoring.router)
+    except Exception:
+        logging.getLogger("gateway.server").exception("Failed to include monitoring.router (skipping)")
