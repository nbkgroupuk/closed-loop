<?xml version="1.0" encoding="UTF-8"?>
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:pain.001.001.03">
  <CstmrCdtTrfInitn>
    <GrpHdr>
      <MsgId>MSG-{{AUTO_OR_MANUAL}}</MsgId>
      <CreDtTm>{{CREATION_DATETIME}}</CreDtTm>
      <NbOfTxs>1</NbOfTxs>
      <CtrlSum>{{TOTAL_AMOUNT}}</CtrlSum>
      <InitgPty>
        <Nm>{{SENDER_COMPANY_NAME}}</Nm>
        <Id>
          <OrgId>
            <Othr>
              <Id>{{MERCHANT_ID}}</Id>
            </Othr>
          </OrgId>
        </Id>
      </InitgPty>
    </GrpHdr>

    <PmtInf>
      <PmtInfId>{{PAYMENT_INFO_ID}}</PmtInfId>
      <PmtMtd>TRF</PmtMtd>
      <BtchBookg>false</BtchBookg>
      <NbOfTxs>1</NbOfTxs>
      <CtrlSum>{{TOTAL_AMOUNT}}</CtrlSum>

      <!-- Debit (merchant account / sender) -->
      <Dbtr>
        <Nm>{{MERCHANT_LEGAL_NAME}}</Nm>
      </Dbtr>
      <DbtrAcct>
        <Id><IBAN>{{MERCHANT_IBAN}}</IBAN></Id>
        <Ccy>{{MERCHANT_CURRENCY}}</Ccy>
      </DbtrAcct>
      <DbtrAgt>
        <FinInstnId>
          <BIC>{{MERCHANT_BANK_BIC}}</BIC>
        </FinInstnId>
      </DbtrAgt>

      <!-- Credit (beneficiary / payout receiver) -->
      <CdtTrfTxInf>
        <PmtId>
          <InstrId>{{INSTRUMENT_ID}}</InstrId>
          <EndToEndId>{{END_TO_END_ID}}</EndToEndId>
        </PmtId>
        <Amt>
          <InstdAmt Ccy="{{BENEFICIARY_CURRENCY}}">{{BENEFICIARY_AMOUNT}}</InstdAmt>
        </Amt>
        <CdtrAgt>
          <FinInstnId>
            <BIC>{{BENEFICIARY_BANK_BIC}}</BIC>
          </FinInstnId>
        </CdtrAgt>
        <Cdtr>
          <Nm>{{BENEFICIARY_NAME}}</Nm>
        </Cdtr>
        <CdtrAcct>
          <Id><IBAN>{{BENEFICIARY_IBAN}}</IBAN></Id>
        </CdtrAcct>
        <RmtInf>
          <Ustrd>{{PAYMENT_REFERENCE}}</Ustrd>
        </RmtInf>
      </CdtTrfTxInf>
    </PmtInf>
  </CstmrCdtTrfInitn>
</Document>
