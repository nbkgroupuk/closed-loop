version: "3.8"

services:
  backend:
    build: ./backend
    container_name: project-backend
    ports:
      - "8002:8000"
    depends_on:
      - gateway
    environment:
      - GATEWAY_HOST=gateway
      - GATEWAY_PORT=8000
    restart: unless-stopped

  frontend:
    build: ./frontend
    container_name: project-frontend
    ports:
      - "3000:80"
    depends_on:
      - backend
    environment:
      - API_BASE=http://localhost:8002
    restart: unless-stopped
  gateway:
    container_name: project-gateway
    image: project-gateway:fixed
    build: ./gateway
    command: >
      uvicorn server.fixed:app
      --host 0.0.0.0
      --port 8000
      --log-level info
    working_dir: /app
    ports:
      - "8000:8000"
    environment:
      - PORT=8000
      - PYTHONPATH=/app
      - PROCESSOR_HOST=
      - PROCESSOR_PORT=9000
    volumes:
      # Mount the repo into /app so live code updates appear immediately
      - ./gateway:/app
      # Optionally mount settlement_handler explicitly if edited often
      - ./gateway/app/app/settlement_handler.py:/app/app/settlement_handler.py
    networks:
      - appnet

  processor:
    container_name: project-processor
    image: project-processor:latest
    build: ./processor
    command: python3 app/tcp_server.py
    working_dir: /app
    ports:
      - "9000:9000"
    environment:
      - PORT=9000
    networks:
      - appnet

networks:
  appnet:
    driver: bridge

