# gateway/app/tcp_client.py
import asyncio
import json
import logging
import os
from typing import Dict, Any, Optional

logger = logging.getLogger("gateway.tcp_client")
logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")

# Configurable retry/timeouts (can be tuned or env-overridden)
ATTEMPTS = int(os.getenv("TCP_CLIENT_ATTEMPTS", "3"))
RETRY_DELAY = float(os.getenv("TCP_CLIENT_RETRY_DELAY", "0.25"))  # base seconds (multiplied by attempt)
CONNECT_TIMEOUT = float(os.getenv("TCP_CLIENT_CONNECT_TIMEOUT", "3.0"))
READ_TIMEOUT = float(os.getenv("TCP_CLIENT_READ_TIMEOUT", "3.0"))

async def _read_exactly(reader: asyncio.StreamReader, n: int, timeout: float) -> bytes:
    """Read exactly n bytes with timeout; raises asyncio.TimeoutError or EOFError on short reads."""
    data = await asyncio.wait_for(reader.readexactly(n), timeout=timeout)
    return data

def _parse_response_payload(payload: bytes) -> Dict[str, Any]:
    """
    Parse the response payload. Accepts:
      - b'0210{"approved": true, ...}'  (MTI + JSON)
      - b'{"approved": true, ...}'       (JSON only)
      - Plain text tokens (e.g. b'ISO-RESPONSE-APPROVED') -> return under raw and set approved/de39 if recognized
    Returns dict: {'mti': Optional[str], 'fields': dict, 'raw': parsed_json_dict or fallback, 'raw_frame_bytes': payload}
    """
    out: Dict[str, Any] = {"mti": None, "fields": {}, "raw": None, "raw_frame_bytes": payload}
    try:
        # If payload begins with ASCII digits (MTI) then split; decode prefix to test digits
        if len(payload) >= 3:
            prefix3 = payload[:3].decode("ascii", errors="ignore")
            if prefix3.isdigit():
                # try 4 then 3
                for l in (4, 3):
                    if len(payload) >= l:
                        prefix = payload[:l].decode("ascii", errors="ignore").strip()
                        if prefix.isdigit():
                            body = payload[l:]
                            try:
                                parsed = json.loads(body.decode("utf-8", errors="replace"))
                                out.update({"mti": prefix, "raw": parsed, "fields": parsed if isinstance(parsed, dict) else {}})
                                return out
                            except Exception:
                                # parsing JSON body failed — break out to try JSON-only fallback
                                break

        # fallback: try parse entire payload as JSON text
        text = payload.decode("utf-8", errors="replace")
        try:
            parsed = json.loads(text)
            out.update({"raw": parsed, "fields": parsed if isinstance(parsed, dict) else {}})
            return out
        except json.JSONDecodeError:
            # Not JSON — keep the raw text. For convenience map some known plain tokens:
            text_stripped = text.strip()
            out["raw"] = {"_raw_text": text_stripped}
            # common simple success token from test processor: "ISO-RESPONSE-APPROVED"
            if text_stripped.upper().startswith("ISO-RESPONSE-APPROVED") or "APPROVED" in text_stripped.upper():
                out["fields"] = {}
                out["de39"] = "00"
                out["approved"] = True
            return out

    except Exception as e:
        logger.exception("Unexpected error parsing payload")
        out["raw"] = {"_error": repr(e)}
        return out

async def send_iso_to_processor(host: str, port: int, mti: str, fields: Dict[Any, Any], timeout: float = READ_TIMEOUT) -> Dict[str, Any]:
    """
    Send an ISO-style framed message to the processor and wait for a framed response.

    Frame format:
      - 4-byte big-endian length (N)
      - N bytes payload which we encode as JSON bytes: {"mti": "<mti>", "fields": {...}}

    Returns a dict with parsed response and convenience keys:
      - mti, fields, raw, raw_frame_bytes, de39 (if found), approved (if found), txn_id (gateway txn id)
    Raises ConnectionError when all attempts fail.
    """
    last_exc: Optional[Exception] = None
    payload_obj = {"mti": mti, "fields": fields}
    payload_bytes = json.dumps(payload_obj, separators=(",", ":")).encode("utf-8")
    hdr = len(payload_bytes).to_bytes(4, byteorder="big")

    for attempt in range(1, ATTEMPTS + 1):
        try:
            logger.info("Sending ISO to processor host=%s port=%s fields=%s (attempt %d/%d)", host, port, fields, attempt, ATTEMPTS)
            reader, writer = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=CONNECT_TIMEOUT)

            # send header + payload
            writer.write(hdr + payload_bytes)
            await writer.drain()

            # read 4-byte header for response
            raw_hdr = await _read_exactly(reader, 4, timeout=timeout)
            rlen = int.from_bytes(raw_hdr, byteorder="big")
            logger.debug("Received response header length=%d", rlen)

            # read exact body length
            body = await _read_exactly(reader, rlen, timeout=timeout)
            logger.debug("Received response payload bytes (len=%d): %r", len(body), body[:200])

            # close socket gracefully
            try:
                writer.close()
                await writer.wait_closed()
            except Exception:
                pass

            # robust parse
            parsed = _parse_response_payload(body)

            # convenience top-level keys (if present in parsed['raw'])
            if isinstance(parsed.get("raw"), dict):
                parsed_de39 = parsed["raw"].get("de39") or parsed["raw"].get("DE39")
                if parsed_de39 is not None:
                    parsed["de39"] = parsed_de39
                parsed["approved"] = parsed["raw"].get("approved", parsed.get("approved"))
                parsed["txn_id"] = parsed["raw"].get("txn_id") or parsed["raw"].get("gateway_txn_id") or parsed.get("txn_id")

            return parsed

        except asyncio.TimeoutError as e:
            last_exc = e
            logger.warning("send_iso_to_processor attempt %d timeout: %s", attempt, repr(e))
        except ConnectionRefusedError as e:
            last_exc = e
            logger.warning("send_iso_to_processor attempt %d connection refused: %s", attempt, repr(e))
        except Exception as e:
            last_exc = e
            logger.exception("send_iso_to_processor attempt %d failed with exception:", attempt)
        # backoff
        await asyncio.sleep(RETRY_DELAY * attempt)

    # All retries exhausted: raise with last exception message
    raise ConnectionError(f"Failed to communicate with processor after {ATTEMPTS} attempts: {last_exc}")
