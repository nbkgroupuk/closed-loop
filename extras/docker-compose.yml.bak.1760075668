# =============================================
# docker-compose.prod.yml  (Production Deployment)
# =============================================
version: '3.8'

services:
  gateway:
    build:
      context: ./gateway
      dockerfile: Dockerfile
    container_name: project-gateway
    volumes:
      - ./secrets/eth_signer_key:/run/secrets/eth_signer_key:ro
      - ./secrets:/app/keys:ro
    environment:
      - ISO20022_VERBOSE=1     # set to 1 to enable verbose logging, 0 or omit to disable
      - PERF_METRICS=1
      - PROCESSOR_URL=http://processor:8000
      - PROCESSOR_HOST=processor
      - PROCESSOR_PORT=9000
      - BANK_API_BASE=http://mock-bank:5002
      - CRYPTO_API_BASE=http://processor:8000/payouts
      - BACKEND_API_BASE=http://backend:8000
      - ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
    command: ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
    ports:
      - "8000:8000"
    restart: unless-stopped
    depends_on:
      processor:
        condition: service_healthy
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:8000/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: project-backend
    volumes:
      - ./secrets/eth_signer_key:/run/secrets/eth_signer_key:ro
    environment:
      - PERF_METRICS=1
      - DATABASE_URL=postgresql+asyncpg://payments:payments_pw@pg_local:5432/payments_db
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
    ports:
      - "8002:8000"
    restart: unless-stopped
    depends_on:
      pg_local:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:8000/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5

  processor:
    build:
      context: ./processor
      dockerfile: Dockerfile
    container_name: project-processor
    volumes:
      - ./secrets/eth_signer_key:/run/secrets/eth_signer_key:ro
      - ./logs:/var/log              # ✅ persistent transaction logs
    environment:
      - PERF_METRICS=1
      - DATABASE_URL=postgresql+asyncpg://payments:payments_pw@pg_local:5432/payments_db
      - LOG_PATH=/var/log/iso_transactions.jsonl
    command: ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
    ports:
      - "8001:8000"                  # REST API
      - "9000:9000"                  # ISO8583 TCP endpoint (external)
    restart: unless-stopped
    depends_on:
      pg_local:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:8000/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5

  mock-bank:
    build:
      context: ./mock-bank
      dockerfile: Dockerfile
    container_name: project-mock-bank
    ports:
      - "5002:5002"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:5002/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: project-frontend
    ports:
      - "3000:80"
    restart: unless-stopped
    depends_on:
      gateway:
        condition: service_healthy
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost/ || exit 1"]
      interval: 30s
      timeout: 3s
      retries: 3

  pg_local:
    image: postgres:15
    container_name: project-pg_local
    environment:
      - PERF_METRICS=1
      POSTGRES_DB: payments_db
      POSTGRES_USER: payments
      POSTGRES_PASSWORD: payments_pw
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U payments -d payments_db || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5

volumes:
  pgdata:
    name: project_pgdata


