version: "3.8"
services:
  pg_local:
    image: postgres:15
    container_name: project-pg_local
    environment:
      POSTGRES_DB: payments_db
      POSTGRES_USER: payments
      POSTGRES_PASSWORD: payments_pw
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U payments -d payments_db || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: project-backend
    environment:
      - DATABASE_URL=postgresql+asyncpg://payments:payments_pw@pg_local:5432/payments_db
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
    ports:
      - "8002:8000"
    depends_on:
      pg_local:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test:
        - CMD
        - bash
        - -c
        - echo > /dev/tcp/127.0.0.1/8000
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
  processor:
    build:
      context: ./processor
      dockerfile: Dockerfile
    container_name: project-processor
    environment:
      - DATABASE_URL=postgresql+asyncpg://payments:payments_pw@pg_local:5432/payments_db
      - LOG_PATH=/var/log/iso_transactions.jsonl
    command: ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8000"]
    ports:
      - "8001:8000"
      - "9000:9000"
    depends_on:
      pg_local:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test:
        - CMD
        - bash
        - -c
        - echo > /dev/tcp/127.0.0.1/9000
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
  gateway:
    build:
      context: ./gateway
      dockerfile: Dockerfile
    container_name: project-gateway
      working_dir: /app
      environment:
        - PYTHONPATH=/app
    environment:
      - PROCESSOR_HOST=processor
      - PROCESSOR_PORT=9000
      - PORT=8000
    command: ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8000"]
    ports:
      - "8000:8000"
    depends_on:
      processor:
        condition: service_healthy
      backend:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test:
        - CMD
        - bash
        - -c
        - echo > /dev/tcp/127.0.0.1/8000
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
  mock-bank:
    build:
      context: ./mock-bank
      dockerfile: Dockerfile
    container_name: project-mock-bank
    ports:
      - "5002:5002"
    restart: unless-stopped
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: project-frontend
    ports:
      - "3000:80"
    depends_on:
      gateway:
        condition: service_healthy
    restart: unless-stopped
  nginx:
    image: nginx:stable
    container_name: project-nginx
    ports:
      - "80:80"
    depends_on:
      - frontend
      - gateway
    restart: unless-stopped
volumes:
  pgdata:

