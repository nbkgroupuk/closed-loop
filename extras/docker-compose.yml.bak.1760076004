version: "3.8"

services:
  gateway:
    image: project-gateway:fixed   # or build: ./gateway if you have a Dockerfile
    container_name: project-gateway
    ports:
      - "8000:8000"
    working_dir: /workspace/gateway/app
    volumes:
      - ./:/workspace:rw
    environment:
      - PORT=8000
      - PYTHONPATH=/workspace/gateway
    networks:
      - appnet

  processor:
    image: project-processor:latest   # or build: ./processor if you have a Dockerfile
    container_name: project-processor
    ports:
      - "9000:9000"
    environment:
      - PORT=8000
    networks:
      - appnet

networks:
  appnet:
    driver: bridge
