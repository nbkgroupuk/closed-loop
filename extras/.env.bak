# === GLOBAL PROJECT ENV (Production Ready) ===
COMPOSE_PROJECT_NAME=project
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@project-pg_local:5432/postgres

# === GATEWAY CONFIG ===
PROCESSOR_HOST=processor
PROCESSOR_PORT=9000
TCP_TIMEOUT=5
MERCHANT_WALLET=0x0000000000000000000000000000000000000000
GATEWAY_BASE=http://127.0.0.1:9002

# === BACKEND CONFIG ===
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000

# === FRONTEND CONFIG ===
NEXT_PUBLIC_API_BASE=http://localhost:8002

# === CRYPTO + BANK ===
CRYPTO_PORT=9001
BANK_PORT=5002
