# PROJECT ENV (production-ready)

# Compose / Postgres
COMPOSE_PROJECT_NAME=project
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@project-pg_local:5432/postgres

# Gateway → Processor comms (use service name 'processor' from docker-compose)
PROCESSOR_HOST=processor
PROCESSOR_PORT=9000
TCP_TIMEOUT=5
MERCHANT_WALLET=0x0000000000000000000000000000000000000000
# internal URL other containers can use; for external testing use localhost:9002
GATEWAY_BASE=http://gateway:9002

# Backend
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000

# Frontend (public-facing URL used by browsers; keep localhost for local dev)
NEXT_PUBLIC_API_BASE=http://localhost:8002

# Other services
CRYPTO_PORT=9001
BANK_PORT=5002
