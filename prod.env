# Production environment (template) - DO NOT COMMIT
ENV=production
DEBUG=false

# Web / service hosts (internals)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
PROCESSOR_HOST=processor
PROCESSOR_PORT=8000

# Database (example - replace with your production DB)
DATABASE_URL=postgresql://payuser:StrongDBPassword@postgres:5432/payments

# Crypto (Infura) - replace <PROJECT_ID> or set in deployment secret
INFURA_URL=https://mainnet.infura.io/v3/6aaea4c2d2be42bf89c660d07863fea5

# Signer - DO NOT put private key here. Use docker secrets or file mount.
# Path where the container can read the private key file (read-only)
ETH_SIGNER_KEY_PATH=/run/secrets/eth_signer_key
ETH_SIGNER_ADDR=0x4fb16bf5c25a97702628b2b3bcfab70844aca95c

# Operation guards
CRYPTO_PROVIDER=infura
ALLOW_REAL_PAYOUTS=true
ALLOW_INSTANT_BANK_PAYOUTS=false  # set true when bank integration is live

# Bank ISO20022 / Payouts (replace with real endpoint once bank config ready)
BANK_API_BASE=https://bank.example.com/iso20022
BANK_API_KEY=

# Logging / secrets
SECRET_KEY=replace_with_strong_random_value

# Monitoring / health
HEALTH_CHECK_PATH=/healthz

# --- Crypto payout detailed config (wire this before enabling real payouts) ---
# Network used for on-chain settlement (e.g. mainnet, sepolia, polygon)
CRYPTO_NETWORK=mainnet

# Asset used for settlement (e.g. USDT, USDC, ETH)
CRYPTO_TOKEN=USDT 

# Merchant destination wallet for payouts (CHANGE THIS TO YOUR REAL WALLET)
CRYPTO_MERCHANT_WALLET=0xf2716f15fea5133a38b3f2f602db37c683fe2e3e

# Callback from crypto service back into your backend (for tx confirmations)
CRYPTO_CALLBACK_URL=https://rutlandprojects.com/api/crypto/callback

# Internal URL that backend/gateway will use to talk to the crypto-payout service
CRYPTO_PAYOUT_BASE_URL=http://crypto-payout:8000
