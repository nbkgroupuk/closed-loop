# backend/app/main.py
import uvicorn
import logging
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app.routes import router as api_router  # your routes module
from app.config import settings
from app.telemetry.metrics import metrics_endpoint
from app.telemetry.logging import configure_logging

# configure logging early
configure_logging(settings.LOG_LEVEL if hasattr(settings, "LOG_LEVEL") else "INFO")
logger = logging.getLogger(__name__)

# create the FastAPI app instance *before* using it
app = FastAPI(title=getattr(settings, "APP_NAME", "backend"), version="0.1.0")

# CORS - liberal for local/dev. Lock down in prod.
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

# attach telemetry endpoint after app exists
app.add_api_route("/metrics", metrics_endpoint, methods=["GET"])

# include the main API routes
app.include_router(api_router)

from fastapi import FastAPI

try:
    app
except NameError:
    app = FastAPI()

@app.get("/healthz")
async def healthz():
    return {"status": "ok", "service": "processor"}   # or "backend"

#@app.get("/health")
#async def health():
    #return {"status": "ok", "service": getattr(settings, "APP_NAME", "backend")}

if __name__ == "__main__":
    uvicorn.run("app.main:app", host="0.0.0.0", port=8000, log_level="info")
