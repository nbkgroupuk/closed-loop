# gateway/app/tcp_client.py
import asyncio
import json
import logging
from typing import Dict, Any

LOG = logging.getLogger("gateway.tcp_client")

async def send_iso_to_processor(host: str, port: int, mti: str, fields: Dict[Any, Any], timeout: float = 5.0):
    """
    Connect to processor TCP live (newline-delimited JSON).
    Send {"mti": mti, "fields": fields} and await one JSON line response.
    """
    try:
        reader, writer = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=timeout)
    except Exception as e:
        LOG.exception("tcp connect error")
        raise

    try:
        payload = json.dumps({"mti": mti, "fields": fields}) + "\n"
        writer.write(payload.encode())
        await writer.drain()

        line = await asyncio.wait_for(reader.readline(), timeout=timeout)
        if not line:
            raise RuntimeError("no response from processor")
        resp = json.loads(line.decode().strip())
        return resp
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass
