# gateway/app/server.py
"""
FastAPI server for payment gateway.
Handles frontend requests and forwards ISO8583 messages to the processor.
"""

from fastapi import FastAPI, Request

def _normalize_payload_fields(payload):
    """Map legacy snake_case keys to camelCase where needed (non-destructive)."""
    try:
        if isinstance(payload, dict):
            if auth_code in payload and authCode not in payload:
                payload[authCode] = payload.pop(auth_code)
    except Exception:
        # best-effort; do not break request processing
        pass
    return payload

from fastapi.responses import JSONResponse
import logging
import asyncio

from tcp_client import send_iso_to_processor

app = FastAPI(title="Payment Gateway API")
LOG = logging.getLogger("gateway.server")
LOG.setLevel(logging.INFO)


@app.get("/health")
async def health():
    return {"status": "ok"}


@app.post("/transactions")
async def process_transaction(request: Request):
    """
    Receive frontend transaction request and forward to processor.
    """
    data = await request.json()
    LOG.info("Received transaction: %s", data)

    mti = data.get("mti", "0800")
    fields = {
        "DE2": data.get("card_number"),
        "DE3": data.get("processing_code", "000000"),
        "DE4": f"{int(float(data.get('amount', 0))*100):012d}",
        "DE7": "1010060054",
        "DE11": "000001",
        "DE12": "060054",
        "DE13": "1010",
        "DE41": data.get("terminal_id", "TERMINAL_ID_PLACEHOLDER"),
        "DE42": data.get("merchant_id", "M1"),
        "DE49": "840"
    }

    result = await send_iso_to_processor(
        mti=mti,
        fields=fields
    )

    return JSONResponse(
        {
            "received": True,
            "data": data,
            "processor_result": {
                "success": result.get("success"),
                "error": result.get("error"),
                "mti_resp": result.get("mti_resp"),
                "json_resp": result.get("json_resp"),
            },
        }
    )
