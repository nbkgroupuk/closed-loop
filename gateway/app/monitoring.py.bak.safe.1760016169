"""
Final production-safe monitoring helper.

- Uses its own CollectorRegistry (avoids duplicate registration errors)
- Always returns 200 on /metrics
- Works even if prometheus_client missing
"""
import logging
log = logging.getLogger("gateway.metrics")

try:
    from prometheus_client import CollectorRegistry, Counter, Histogram, generate_latest, CONTENT_TYPE_LATEST
    _REGISTRY = CollectorRegistry()
    REQUESTS = Counter("gateway_requests_total", "Total HTTP requests", ["method","endpoint","status"], registry=_REGISTRY)
    FAILURES = Counter("gateway_failures_total", "Total failures by endpoint", ["endpoint"], registry=_REGISTRY)
    DURATION = Histogram("gateway_request_duration_seconds", "Request duration in seconds", ["method","endpoint"], registry=_REGISTRY)
    HAVE_PROM = True
except Exception as e:
    log.warning("Prometheus client not available: %s", e)
    HAVE_PROM = False
    class _NoOp:
        def __getattr__(self, name):
            def _noop(*a, **k): return None
            return _noop
    REQUESTS = FAILURES = DURATION = _NoOp()
    def generate_latest(_=None): return b""
    CONTENT_TYPE_LATEST = "text/plain; charset=utf-8"

from fastapi import APIRouter, Response
router = APIRouter()

@router.get("/metrics")
def metrics():
    try:
        if HAVE_PROM:
            data = generate_latest(_REGISTRY)
        else:
            data = b""
        return Response(content=data, media_type=CONTENT_TYPE_LATEST)
    except Exception as e:
        log.exception("metrics generation failed: %s", e)
        return Response(content=b"", media_type="text/plain", status_code=500)

def observe_request(method, endpoint, status, duration, failed=False):
    try:
        if not HAVE_PROM:
            return
        DURATION.labels(method=method, endpoint=endpoint).observe(duration)
        REQUESTS.labels(method=method, endpoint=endpoint, status=str(status)).inc()
        if failed:
            FAILURES.labels(endpoint=endpoint).inc()
    except Exception:
        log.debug("observe_request failed", exc_info=True)
