# gateway_app.py
# Ready-to-drop, robust FastAPI gateway that forwards JSON->framed-TCP to processor
# - Defines app first (prevents NameError on startup)
# - Adds permissive CORS for local development (tighten for prod)
# - Ensures payload uses an ISO MTI prefix (0200) expected by processor
# - Frames payload with 4-byte big-endian length
# - Strips ISO MTI prefix from responses (e.g. "0210{...}") before JSON decode
# - Interprets ISO field 39 and returns appropriate HTTP status codes

from fastapi import FastAPI, Request, HTTPException
from fastapi.middleware.cors import CORSMiddleware
import socket
import json
import os
import logging
import re
from typing import Optional

# Basic logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("gateway")

app = FastAPI(title="Gateway")

# CORS (development-friendly). For production restrict origins.
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Processor connection configuration
PROCESSOR_HOST = os.environ.get("PROCESSOR_HOST", "processor")
# accept either numeric string or env var already containing port
_PROCESSOR_PORT = os.environ.get("PROCESSOR_PORT", "9000")
try:
    PROCESSOR_PORT = int(_PROCESSOR_PORT)
except Exception:
    PROCESSOR_PORT = 9000

TCP_TIMEOUT = float(os.environ.get("TCP_TIMEOUT", "5"))


@app.get("/health")
def health():
    return {"status": "ok"}


@app.post("/payout")
async def payout_handler(request: Request):
    # validate request JSON
    try:
        body = await request.json()
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Invalid JSON body: {e}")

    if not isinstance(body, dict) or body.get("type") != "iso20022":
        raise HTTPException(status_code=400, detail="Only type=iso20022 supported in this route")

    # prepare payload bytes (JSON) and ensure leading ISO MTI (0200 request)
    try:
        payload_bytes = json.dumps(body, default=str).encode("utf-8")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Failed to serialize body: {e}")

    try:
        # if processor expects MTI like 4 ASCII bytes "0200"/"0210", prefix it
        if not (payload_bytes.startswith(b"0200") or payload_bytes.startswith(b"0210")):
            payload_bytes = b"0200" + payload_bytes
    except Exception:
        # fallback: re-encode with safe prefix
        payload_bytes = b"0200" + json.dumps(body, default=str).encode("utf-8")

    # frame: 4-byte big-endian length followed by payload
    length = len(payload_bytes)
    framed = length.to_bytes(4, "big") + payload_bytes

    # talk to processor over TCP
    try:
        with socket.create_connection((PROCESSOR_HOST, PROCESSOR_PORT), timeout=TCP_TIMEOUT) as s:
            s.sendall(framed)

            # read 4-byte response header
            hdr = b""
            while len(hdr) < 4:
                chunk = s.recv(4 - len(hdr))
                if not chunk:
                    break
                hdr += chunk

            if not hdr or len(hdr) < 4:
                raise RuntimeError("no response header from processor")

            resp_len = int.from_bytes(hdr, "big")

            # read the response payload
            resp_bytes = b""
            toread = resp_len
            while toread:
                chunk = s.recv(toread)
                if not chunk:
                    break
                resp_bytes += chunk
                toread -= len(chunk)

    except Exception as e:
        logger.exception("Processor comms failed")
        raise HTTPException(status_code=502, detail=f"Processor comms failed: {e}")

    # decode response and strip possible ISO MTI prefix like 0210
    try:
        resp_text = resp_bytes.decode("utf-8", errors="replace").strip()
        # remove leading 3-4 digit MTI (e.g., '0210') or any short ASCII MTI
        resp_text = re.sub(r"^[0-9]{3,4}", "", resp_text).strip()
        resp_json = json.loads(resp_text) if resp_text else {}
    except json.JSONDecodeError as e:
        logger.exception("JSON decode failed for processor response")
        raise HTTPException(status_code=502, detail=f"JSON decode failed from processor: {e}")
    except Exception as e:
        logger.exception("Failed to parse processor response")
        raise HTTPException(status_code=502, detail=f"Failed to parse processor response: {e}")

    # inspect ISO field 39 (response code) if present
    resp_code: Optional[str] = None
    if isinstance(resp_json, dict):
        try:
            resp_code = resp_json.get("fields", {}).get("39")
        except Exception:
            resp_code = None

    # logging for observability
    logger.info("Processor response code=%s payload=%s", resp_code, resp_json)

    # code mapping (extend as needed)
    code_map = {
        "00": "approved",
        "05": "do_not_honor",
        "12": "invalid_transaction",
        "13": "invalid_amount",
        "14": "invalid_card_number",
        "30": "format_error",
        "41": "lost_card",
        "43": "stolen_card",
        "51": "insufficient_funds",
        "54": "expired_card",
        "55": "incorrect_pin",
        "91": "issuer_unavailable",
        "96": "system_malfunction",
    }

    # success
    if resp_code == "00":
        return {"status": "approved", "code": resp_code, "response": resp_json}

    reason = code_map.get(resp_code, "declined" if resp_code else "no_response_code")

    # upstream/system errors -> 502
    if resp_code in (None, "91", "96"):
        raise HTTPException(status_code=502, detail=f"Processor error ({resp_code}): {reason}")

    # client/payment declined -> 402 (payment required) or 400-range as you prefer
    raise HTTPException(status_code=402, detail=f"Payment declined ({resp_code}): {reason}")
