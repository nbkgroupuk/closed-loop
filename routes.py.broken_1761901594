# ---------- Dashboard / Monitor render endpoints ----------
# NOTE: these require jinja2 to be present in the image. If you don't want templates,
# remove these endpoints or install jinja2 in the container.
try:
    from fastapi.templating import Jinja2Templates
    from fastapi.responses import HTMLResponse
    templates = Jinja2Templates(directory=os.path.join(os.getcwd(), "templates"))

    @router.get("/dashboard", response_class=HTMLResponse)
    def dashboard(request: Request):
        txns = _read(TX_FILE)
        payouts = _read(PO_FILE)
        now = datetime.datetime.utcnow().isoformat()
        return templates.TemplateResponse("dashboard.html", {"request": request, "txns": txns, "payouts": payouts, "now": now})

    @router.get("/monitor", response_class=HTMLResponse)
    def monitor(request: Request):
        txns = _read(TX_FILE)
        payouts = _read(PO_FILE)
        now = datetime.datetime.utcnow().isoformat()
        return templates.TemplateResponse("monitor.html", {"request": request, "transactions": txns, "payouts": payouts, "now": now})
except Exception:
    logger.info("jinja2/templates not available — dashboard endpoints disabled")

