# ---------- Main transaction endpoint (async, DB-backed) ----------
@router.post("/transactions")
async def create_transaction(payload: TransactionIn, request: Request, idempotency_key: Optional[str] = Header(None)):
    correlation_id = str(uuid.uuid4())
    # idempotency handling
    raw = payload.dict()
    key = idempotency_key or canonical_request_hash(raw)
    async with AsyncSessionLocal() as session:
        # check existing idempotent
        q = await session.execute(select(Transaction).where(Transaction.idempotency_key==key))
        existing = q.scalars().first()
        if existing:
            return {"approved": existing.status == TxStatus.APPROVED, "de39": existing.de39, "de38": existing.de38, "txn_id": str(existing.id)}

        # persist transaction PENDING
        txn = Transaction(
            merchant_id=payload.merchant_id,
            amount=payload.amount,
            currency=payload.currency,
            pan_mask=f"****{payload.cardNumber[-4:]}",
            expiry=payload.expiry,
            protocol=payload.protocol,
            correlation_id=correlation_id,
            idempotency_key=key,
            meta={"payoutMethod": payload.payoutMethod}
        )
        session.add(txn)
        await session.commit()
        await session.refresh(txn)

        # Broadcast mti.outgoing
        await ws_manager.broadcast(payload.merchant_id, "mti.outgoing", {"correlation_id": correlation_id, "txn_id": str(txn.id), "masked_pan": txn.pan_mask})

        # send to Gateway for ISO8583 auth
        gw_payload = {
            "txn_id": str(txn.id),
            "pan": payload.cardNumber,
            "expiry": payload.expiry,
            "cvc": payload.cvc,
            "amount": str(payload.amount),
            "currency": payload.currency,
            "protocol": payload.protocol,
            "authCode": payload.authCode,
            "correlation_id": correlation_id
        }
        try:
            gw_resp = await gateway_client.auth_transaction(gw_payload)
        except Exception as e:
            txn.status = TxStatus.FAILED
            txn.de39 = "96"
            session.add(txn); await session.commit()
            await ws_manager.broadcast(payload.merchant_id, "mti.incoming", {"correlation_id": correlation_id, "de39":"96", "error": str(e)})
            raise HTTPException(status_code=502, detail="Gateway error: " + str(e))

        # update transaction based on gateway response
        txn.gateway_txn_id = gw_resp.get("gateway_txn_id")
        de39_val = gw_resp.get("de39") || gw_resp.get("DE39") || (gw_resp.get("raw")||{}).get("39") || (gw_resp.get("raw")||{}).get("de39") || "96"
            txn.de39 = str(de39_val)
            if "approved" not in gw_resp or gw_resp.get("approved") is None:
                gw_resp["approved"] = (str(de39_val) == "00")
        txn.de38 = gw_resp.get("de38")
        if gw_resp.get("approved"):
            txn.status = TxStatus.APPROVED
            # enqueue payout in outbox
            payout = Payout(
                transaction_id=txn.id,
                merchant_id=txn.merchant_id,
                type=PayoutType.BANK if (payload.payoutMethod or "").lower().startswith("bank") else PayoutType.CRYPTO,
                status=PayoutStatus.PENDING,
                payload={"auto": True, "requested_at": datetime.datetime.utcnow().isoformat()}
            )
            session.add(payout)
            # outbox entry for payout worker (iso20022 or crypto)
            target = "iso20022" if payout.type == PayoutType.BANK else "crypto_send"
            out = Outbox(target=target, payload={"transaction_id": str(txn.id), "payout_id": None})
            session.add(out)
        else:
            txn.status = TxStatus.REJECTED
        session.add(txn)
        # store event log
        ev = EventLog(correlation_id=correlation_id, topic="mti.incoming", payload=gw_resp)
        session.add(ev)
        await session.commit()

        # broadcast incoming MTI
        await ws_manager.broadcast(payload.merchant_id, "mti.incoming", {"correlation_id": correlation_id, "txn_id": str(txn.id), "de39": txn.de39, "de38": txn.de38, "status": txn.status.value})
        return {"approved": txn.status == TxStatus.APPROVED, "de39": txn.de39, "de38": txn.de38, "txn_id": str(txn.id)}

# ---------- Lightweight local file-backed endpoints for dashboard/quick testing ----------
# These endpoints are intentionally simple helpers for local testing / UI preview.
DATA_DIR = os.environ.get("BACKEND_DATA_DIR", os.path.join(os.getcwd(), "data"))
os.makedirs(DATA_DIR, exist_ok=True)
TX_FILE = os.path.join(DATA_DIR, "transactions.json")
PO_FILE = os.path.join(DATA_DIR, "payouts.json")

def _read(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return []

def _write(path, arr):
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(arr, fh, indent=2, default=str)

def _append(path, record):
    arr = _read(path)
    arr.insert(0, record)
    _write(path, arr)

class TransactionReq(BaseModel):
    merchant_id: Optional[str] = None
    cardNumber: str
    expiry: str
    cvc: str
    amount: float
    currency: str = "USD"
    protocol: Optional[str] = None
    authCode: Optional[str] = None
    txn_id: Optional[str] = None
    correlation_id: Optional[str] = None

@router.post("/transactions/local")
def transactions_forward(payload: TransactionReq):
    gw_payload = payload.dict()
    gw_payload["txn_id"] = gw_payload.get("txn_id") or str(uuid.uuid4())
    gw_payload["protocol"] = gw_payload.get("protocol") or "POS Terminal -101.1 (4-digit approval)"
    gw_payload["authCode"] = gw_payload.get("authCode") or "1234"
    gw_payload["merchant_id"] = gw_payload.get("merchant_id") or "M123"

    # record pending
    rec = {
        "id": gw_payload["txn_id"],
        "amount": gw_payload["amount"],
        "currency": gw_payload["currency"],
        "status": "pending",
        "approved": False,
        "de39": None,
        "raw_request": gw_payload,
        "raw_response": None,
        "created_at": datetime.datetime.utcnow().isoformat()
    }
    _append(TX_FILE, rec)

    # forward to gateway
    try:
        resp = forward_to_gateway("/transactions", gw_payload, timeout=15)
    except Exception as e:
        rec["status"] = "failed"
        rec["raw_response"] = {"error": str(e)}
        _append(TX_FILE, rec)
        raise HTTPException(status_code=502, detail=f"Gateway comms failed: {e}")

    # update record
    rec["raw_response"] = resp
    rec["de39"] = resp.get("de39")
    rec["approved"] = bool(resp.get("approved"))
    rec["status"] = "success" if rec["approved"] else "failed"
    _append(TX_FILE, rec)
    return resp

class ISO20022Payout(BaseModel):
    creditor_name: str
    amount: float
    currency: str = "USD"
    pain_xml: str
    correlation_id: Optional[str] = None

@router.post("/payout/iso20022")
def payout_iso20022(payload: ISO20022Payout):
    data = payload.dict()
    data["correlation_id"] = data.get("correlation_id") or str(uuid.uuid4())
    rec = {
        "id": str(uuid.uuid4()),
        "type": "iso20022",
        "amount": data["amount"],
        "currency": data["currency"],
        "status": "pending",
        "raw_request": data,
        "raw_response": None,
        "created_at": datetime.datetime.utcnow().isoformat()
    }
    _append(PO_FILE, rec)
    try:
        resp = forward_to_gateway("/payout", data, timeout=20)
    except Exception as e:
        rec["status"] = "failed"
        rec["raw_response"] = {"error": str(e)}
        _append(PO_FILE, rec)
        raise HTTPException(status_code=502, detail=f"Gateway comms failed: {e}")

    rec["raw_response"] = resp
    rec["status"] = "success" if resp.get("ok") or resp.get("approved") else "failed"
    rec["reference"] = resp.get("gateway_txn_id") or resp.get("txn_id")
    _append(PO_FILE, rec)
    return resp

