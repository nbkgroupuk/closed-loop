# Protocol auth mapping copied from frontend index.html (kept for reference if needed).
PROTOCOL_AUTH_LENGTH = {
  "POS Terminal -101.1 (4-digit approval)": 4,
  "POS Terminal -101.4 (6-digit approval)": 6,
  "POS Terminal -101.6 (Pre-authorization)": 6,
  "POS Terminal -101.7 (4-digit approval)": 4,
  "POS Terminal -101.8 (PIN-LESS transaction)": 4,
  "POS Terminal -201.1 (6-digit approval)": 6,
  "POS Terminal -201.3 (6-digit approval)": 6,
  "POS Terminal -201.5 (6-digit approval)": 6
}

# Canonical short-code -> auth length mapping (used internally)
SHORT_PROTOCOL_LEN = {
  "101.1": 4,
  "101.4": 6,
  "101.6": 6,
  "101.7": 4,
  "101.8": 4,
  "201.1": 6,
  "201.3": 6,
  "201.5": 6
}

# ---------- Payload models ----------
class TransactionIn(BaseModel):
    merchant_id: str = Field(..., description="Merchant identifier")
    cardNumber: str
    expiry: str
    cvc: str
    amount: float
    currency: str
    protocol: str
    authCode: str
    payoutMethod: Optional[str] = None
    payoutDetails: Optional[dict] = None

    @validator("cardNumber")
    def card_valid(cls, v):
        v2 = "".join([c for c in v if c.isdigit()])
        if len(v2) != 16:
            raise ValueError("cardNumber must be 16 digits")
        return v2

    @validator("expiry")
    def expiry_valid(cls, v):
        import re, datetime
        if not re.match(r"^(0[1-9]|1[0-2])\/\d{2}$", v):
            raise ValueError("expiry must be MM/YY")
        mm, yy = v.split("/")
        exp = datetime.datetime(2000+int(yy), int(mm), 1)
        now = datetime.datetime.utcnow(); now = now.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
        if exp < now:
            raise ValueError("card expiry in past")
        return v

    @validator("cvc")
    def cvc_valid(cls, v):
        if not v.isdigit() or len(v) not in (3,4):
            raise ValueError("cvc invalid")
        return v

    @validator("protocol")
    def protocol_allowed(cls, v):
        """
        Accept either:
          - short form like "101.1" (recommended/universal), OR
          - frontend full label like "POS Terminal -101.1 (4-digit approval)"
        Normalize and return the short form (e.g. "101.1") so downstream logic uses a canonical key.
        """
        if not v or not isinstance(v, str):
            raise ValueError("protocol not allowed")
        s = v.strip()

        # 1) If input already short numeric code like 101.1
        if re.match(r'^\d{3}\.\d$', s):
            if s in SHORT_PROTOCOL_LEN:
                return s
            raise ValueError("protocol not allowed")

        # 2) Try to extract numeric code from full label (e.g. "POS Terminal -101.1 (4-digit approval)")
        m = re.search(r'(\d{3}\.\d)', s)
        if m:
            code = m.group(1)
            if code in SHORT_PROTOCOL_LEN:
                return code

        # 3) Fallback: also accept the exact original full keys (backwards compatibility)
        if s in PROTOCOL_AUTH_LENGTH:
            # find numeric code in that label
            m2 = re.search(r'(\d{3}\.\d)', s)
            if m2 and m2.group(1) in SHORT_PROTOCOL_LEN:
                return m2.group(1)
            # if no numeric found, accept the label but attempt to map to numeric via PROTOCOL_AUTH_LENGTH
            return s

        raise ValueError("protocol not allowed")

    @validator("authCode")
    def auth_code_len(cls, v, values):
        proto = values.get("protocol")
        if proto:
            # proto may be short-form like "101.1" (preferred)
            required = None
            if isinstance(proto, str) and proto in SHORT_PROTOCOL_LEN:
                required = SHORT_PROTOCOL_LEN.get(proto)
            else:
                # fallback: if proto is the full label, use PROTOCOL_AUTH_LENGTH
                required = PROTOCOL_AUTH_LENGTH.get(proto)
            if required and (not v.isdigit() or len(v) != required):
                raise ValueError(f"authCode must be {required} digits for {proto}")
        return v

